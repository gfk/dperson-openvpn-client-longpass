# syntax=docker/dockerfile:1.7
# Defaults track Alpine's current stable release so they cannot go stale:
# alpine:latest is always the newest stable, and an empty ALPINE_BRANCH is
# derived from the base image's /etc/os-release at build time. CI resolves and
# passes both explicitly; override them to build against an older release.
ARG ALPINE_VERSION=latest
ARG ALPINE_BRANCH=
# Empty = clone the tip of ALPINE_BRANCH; set to a commit SHA to pin aports.
ARG APORTS_REF=
ARG BASE_DIGEST

# ---------- build custom .apk from aports (non-root) ----------
FROM alpine:${ALPINE_VERSION} AS apkbuild
ARG ALPINE_BRANCH
ARG APORTS_REF

# tooling + sudo
RUN apk add --no-cache alpine-sdk abuild git sudo

# ensure main + community are enabled (some images comment community)
RUN set -eux; \
    sed -i 's|^#\(https://dl-cdn.alpinelinux.org/alpine/.*/community\)|\1|' /etc/apk/repositories; \
    apk update

# unprivileged packager
RUN adduser -D -h /home/builder builder \
 && addgroup builder abuild \
 && addgroup builder wheel \
 && echo '%wheel ALL=(ALL) NOPASSWD:ALL' >/etc/sudoers.d/wheel

USER builder
WORKDIR /home/builder

# aports for the branch matching the base image: ALPINE_BRANCH is derived from
# /etc/os-release when unset, so it follows whatever alpine:latest resolves to.
# Cloned from the GitHub mirror because gitlab.alpinelinux.org answers HTTP 418
# (anti-bot) to GitHub Actions runner IPs, which breaks the build on every cold
# cache. The mirror carries the same branch names. Sparse + blob-filtered: the
# only thing we need out of the tree is main/openvpn.
# APORTS_REF pins the checkout to a commit; unset means the branch tip.
RUN set -eux; \
    if [ -z "${ALPINE_BRANCH:-}" ]; then \
        . /etc/os-release; \
        case "${VERSION_ID}" in \
            *_*) ALPINE_BRANCH=master ;; \
            *)   ALPINE_BRANCH="${VERSION_ID%.*}-stable" ;; \
        esac; \
    fi; \
    echo "aports branch: ${ALPINE_BRANCH}"; \
    git clone --depth=1 --filter=blob:none --sparse --no-tags \
        -b "${ALPINE_BRANCH}" \
        https://github.com/alpinelinux/aports.git; \
    cd aports; \
    git sparse-checkout set main/openvpn; \
    if [ -n "${APORTS_REF:-}" ]; then \
        git fetch --depth=1 --filter=blob:none --no-tags origin "${APORTS_REF}"; \
        git checkout --detach FETCH_HEAD; \
    fi; \
    git rev-parse HEAD

WORKDIR /home/builder/aports/main/openvpn

# bump pkgrel, ensure options, inject our sed into prepare()
RUN set -eux; \
  old_rel="$(awk -F= '/^pkgrel=/{print $2; exit}' APKBUILD || echo 0)"; \
  new_rel="$((old_rel + 1))"; \
  sed -i "s/^pkgrel=.*/pkgrel=${new_rel}/" APKBUILD; \
  grep -q '^options=' APKBUILD || echo 'options="!check"' >> APKBUILD; \
  if grep -q '^prepare[[:space:]]*()' APKBUILD; then \
    awk 'BEGIN{done=0} {print} /^prepare[[:space:]]*\(\)[[:space:]]*\{$/ && !done { \
      print "    default_prepare"; \
      print "    sed -i '\''s/#define USER_PASS_LEN 128/#define USER_PASS_LEN (1 << 17)/'\'' src/openvpn/misc.h"; \
      print "    sed -i '\''/PACKAGE_STRING/ s/$/ \"-longpass1\"/'\'' src/openvpn/options.c"; \
      done=1 }' APKBUILD > APKBUILD.tmp && mv APKBUILD.tmp APKBUILD; \
  else \
    printf '\nprepare() {\n    default_prepare\n    sed -i '\''s/#define USER_PASS_LEN 128/#define USER_PASS_LEN (1 << 17)/'\'' src/openvpn/misc.h\n    sed -i '\''/PACKAGE_STRING/ s/$/ "-longpass1"/'\'' src/openvpn/options.c\n}\n' >> APKBUILD; \
  fi

# keygen, trust pubkey, install makedepends into the current root, then build with fakeroot (no chroot)
RUN set -eux; \
  abuild-keygen -a -n -q; \
  sudo install -D -m 0644 /home/builder/.abuild/*.rsa.pub /etc/apk/keys/$(basename /home/builder/.abuild/*.rsa.pub); \
  echo "PACKAGER_PRIVKEY=$(ls /home/builder/.abuild/*.rsa)" > /home/builder/.abuild/abuild.conf; \
  abuild checksum; \
  abuild deps; \
  abuild -F; \
  # --- gather the artifact to a stable path ---
  mkdir -p /home/builder/out; \
  PKG="$(find /home/builder/packages -type f -name 'openvpn-[0-9]*.apk' | head -n1)"; \
  test -n "$PKG"; \
  cp "$PKG" /home/builder/out/; \
  cp /home/builder/.abuild/*.rsa.pub /home/builder/out/

# ---------- minimal runtime (unchanged) ----------
FROM alpine:${ALPINE_VERSION}

ARG BASE_DIGEST
LABEL maintainer="Guillaume Filion <guillaume@filion.org>" \
      org.opencontainers.image.base.digest=$BASE_DIGEST

RUN apk --no-cache --no-progress upgrade && \
    apk --no-cache --no-progress add \
      bash tini shadow shadow-login \
      iptables ip6tables

# dperson conventions
RUN addgroup -S vpn && adduser -S -G vpn -s /sbin/nologin vpn \
 && install -d -m 0750 -o root -g vpn /vpn

# bring in the compiled OpenVPN .apk
COPY --from=apkbuild /home/builder/out/*.rsa.pub /etc/apk/keys/
COPY --from=apkbuild /home/builder/out/openvpn-*.apk /tmp/
RUN apk add --no-cache /tmp/openvpn-*.apk && rm -f /tmp/openvpn-*.apk

COPY --chmod=0755 openvpn.sh /openvpn.sh
WORKDIR /vpn
ENTRYPOINT ["/sbin/tini","--","/openvpn.sh"]
